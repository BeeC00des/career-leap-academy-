# Copy to server/.env for local dev. All optional locally; NODE_ENV=production requires MONGO_URI + JWT_SECRET.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/careerleap?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
TRUST_PROXY=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareerLeap <no-reply@career-leap.academy>
